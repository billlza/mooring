---
source: crates/render/src/tests/goldens.rs
description: "SPDX-License-Identifier: GPL-3.0-or-later. mooring-render nftables.conf (design 8.5); the file is this text plus one newline."
---
flush ruleset

define VPS4 = 45.67.89.10

table inet mooring {
	counter xray_guard {
		packets 0 bytes 0
	}

	counter hy2_guard {
		packets 0 bytes 0
	}

	counter flow_cap {
		packets 0 bytes 0
	}

	counter probe_flows {
		packets 0 bytes 0
	}

	set exit_closed {
		type ifname
		elements = { "wgexit" }
	}

	set camo_targets {
		type ipv4_addr
		elements = { 45.67.89.200 }
	}

	set camo_tcp_src {
		type ipv4_addr
		size 65536
		flags dynamic
	}

	set camo_udp_src {
		type ipv4_addr
		size 65536
		flags dynamic,timeout
		timeout 2m
	}

	set refl_src {
		type ipv4_addr
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set abuse_cut {
		type ipv4_addr
		size 256
	}

	set user_conns {
		type ipv4_addr
		size 4096
		flags dynamic
	}

	set user_rate {
		type ipv4_addr
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set user_datagrams {
		type ipv4_addr
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set user_dst {
		type ipv4_addr . mark
		size 32768
		flags dynamic,timeout
		timeout 5m
	}

	set user_port {
		type ipv4_addr . inet_service
		size 8192
		flags dynamic,timeout
		timeout 5m
	}

	set user_burst {
		type ipv4_addr . mark
		size 32768
		flags dynamic,timeout
		timeout 2m
	}

	set user_login {
		type ipv4_addr . mark
		size 32768
		flags dynamic,timeout
		timeout 10m
	}

	set user_mail {
		type ipv4_addr . mark
		size 32768
		flags dynamic,timeout
		timeout 60m
	}

	set meter_new {
		type ipv4_addr . inet_proto
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set meter_out {
		type ipv4_addr . inet_proto
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set meter_in {
		type ipv4_addr
		size 4096
		flags dynamic,timeout
		timeout 1m
	}

	set user_capped {
		type ipv4_addr
		size 4096
		flags dynamic,timeout
		timeout 5m
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state invalid drop
		iifname "wgexit" ip daddr @abuse_cut drop
		iifname "wgexit" ip daddr 198.18.0.0/15 add @meter_in { ip daddr counter }
		ct state established,related accept
		iifname "lo" accept
		iifname "wgexit" drop
		meta l4proto { icmp, ipv6-icmp } accept
		ip daddr $VPS4 tcp dport { 22, 443 } accept
		ip daddr $VPS4 tcp dport 80 ct state new add @camo_tcp_src { ip saddr ct count over 64 } reject with tcp reset
		ip daddr $VPS4 tcp dport 80 accept
		ip daddr $VPS4 udp dport 443 ct state new add @camo_udp_src { ip saddr limit rate over 50/second burst 200 packets } drop
		ip daddr $VPS4 udp dport 443 accept
		ip daddr $VPS4 udp dport { 27820, 61000 } accept
		ip daddr $VPS4 tcp dport 27900 ct state new add @refl_src { ip saddr limit rate over 5/second burst 10 packets } drop
		ip daddr $VPS4 tcp dport 27900 accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
		oifname @exit_closed meta l4proto tcp reject with tcp reset
		oifname @exit_closed reject with icmpx host-unreachable
		meta skuid "mooring-xray" ct direction original oifname "wgexit" ip daddr != 10.77.0.0/16 jump exit_flow
		meta skuid "mooring-xray" ct direction original ip daddr @camo_targets tcp dport { 80, 443 } accept
		meta skuid "mooring-xray" ct direction original ip daddr @camo_targets udp dport 443 accept
		meta skuid "mooring-xray" ct direction original counter name xray_guard reject
		meta skuid "mooring-hy2" ct direction original ip daddr 127.0.0.1 tcp dport 10443 accept
		meta skuid "mooring-hy2" ct direction original counter name hy2_guard reject
	}

	chain exit_flow {
		ip saddr @abuse_cut meta l4proto tcp reject with tcp reset
		ip saddr @abuse_cut reject with icmpx admin-prohibited
		ip daddr $VPS4 tcp dport 27900 ct state new counter name probe_flows
		ip saddr 198.18.0.0/15 jump user_flow
		ct state new ct count over 4096 counter name flow_cap reject
		accept
	}

	chain user_flow {
		ct state new ct mark set jhash ip daddr mod 4096 seed 0x6d6f6f72
		ct state new update @user_dst { ip saddr . ct mark }
		ct state new add @user_burst { ip saddr . ct mark counter }
		ct state new meta l4proto { tcp, udp } update @user_port { ip saddr . th dport & 1023 }
		ct state new tcp dport { 21, 22, 23, 110, 143, 445, 993, 995, 1433, 3306, 3389, 5432, 5900, 6379, 27017 } add @user_login { ip saddr . ct mark counter }
		ct state new tcp dport { 465, 587 } update @user_mail { ip saddr . ct mark }
		ct state new add @meter_new { ip saddr . meta l4proto counter }
		add @meter_out { ip saddr . meta l4proto counter }
		ct state new add @user_conns { ip saddr ct count over 1024 } add @user_capped { ip saddr counter } reject
		ct state new update @user_rate { ip saddr limit rate over 50/second burst 500 packets } add @user_capped { ip saddr counter } reject
		meta l4proto udp update @user_datagrams { ip saddr limit rate over 1500/second burst 3000 packets } add @user_capped { ip saddr counter } drop
	}

	chain prerouting_nat {
		type nat hook prerouting priority dstnat; policy accept;
		ip daddr $VPS4 udp dport 61001-62999 redirect to :61000
	}

	chain postrouting_nat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wgexit" ip saddr 198.18.0.0/15 snat ip to 10.77.1.1
	}
}
