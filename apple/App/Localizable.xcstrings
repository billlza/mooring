    },
    "Colours follow common LTE rules of thumb (RSRP −80/−90/−100 dBm, SINR 20/13/0 dB); they only help with placing the antenna.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色按常见的 LTE 经验值标注（RSRP −80/−90/−100 dBm，SINR 20/13/0 dB），只用来帮助摆放天线。"
          }
        }
      }
    },
