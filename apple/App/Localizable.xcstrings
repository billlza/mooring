    "1 unassigned slot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个未分配槽位"
          }
        }
      }
    },
    "A line from mooringctl could not be read: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 mooringctl 输出的一行：%@"
