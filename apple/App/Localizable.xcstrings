{
  "sourceLanguage": "en",
  "strings": {
    "%@ (primary)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（主载波）"
          }
        }
      }
    },
    "%@ · %@": {
      "shouldTranslate": false
    },
    "%d °C, %@": {
      "shouldTranslate": false
    },
