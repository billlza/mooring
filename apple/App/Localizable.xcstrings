        }
      }
    },
    "A line from mooringctl was longer than 1 MiB, so the app stopped reading it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mooringctl 输出的一行超过了 1 MiB，应用已停止读取。"
