    },
    "Source": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源"
          }
        }
      }
    },
    "Stage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶段"
          }
        }
      }
    },
    "Standby": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用节点"
          }
        }
      }
    },
    "Start or stop Mooring's daemon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动或停止 Mooring 守护进程"
          }
        }
      }
    },
    "Start the Daemon at Login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动守护进程"
          }
        }
      }
    },
    "Started": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始"
          }
        }
      }
    },
    "Starting the engine": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动引擎"
          }
        }
      }
    },
    "State": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Status from %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态时间 %@"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限策略"
          }
        }
      }
    },
    "Stop the Daemon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止守护进程"
          }
        }
      }
    },
    "Suspended": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
    },
    "Suspended (%@) since %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %2$@ 起暂停（%1$@）"
          }
        }
      }
    },
    "Taken on record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受时间"
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        }
      }
    },
    "The %@ probe through %@ failed (%@).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经 %2$@ 的 %1$@ 探测失败（%3$@）。"
          }
        }
      }
    },
    "The M7 did not answer on its interface. Check that it is on and that the USB Ethernet adapter is connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 在它的接口上没有应答。请检查 M7 是否开机、USB 网卡是否插好。"
          }
        }
      }
    },
    "The M7 did not grant an administrator's session. If its admin password changed, store it again with `mooringctl router set-password`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 没有给出管理员会话。如果改过管理员密码，请用 `mooringctl router set-password` 重新保存。"
          }
        }
      }
    },
    "The M7 has no service": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 无服务"
          }
        }
      }
    },
    "The M7 is on LTE, not 5G": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 在用 LTE，不是 5G"
          }
        }
      }
    },
    "The M7 is overheating (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 过热（%@）"
          }
        }
      }
    },
    "The M7 is unreachable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上 M7"
          }
        }
      }
    },
    "The M7 rebooted (its uptime is shorter than at the last read)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 已重启（运行时间比上次读取时短）"
          }
        }
      }
    },
    "The M7 refused the login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 拒绝了登录"
          }
        }
      }
    },
    "The M7 reports another SIM than the one on record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 报告的 SIM 卡与登记时的不同"
          }
        }
      }
    },
    "The M7 reports another network than the one on record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 报告的网络与登记时的不同"
          }
        }
      }
    },
    "The M7 restarted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 重启过"
          }
        }
      }
    },
    "The M7 stepped its radio down for heat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 因过热降低了无线性能"
          }
        }
      }
    },
    "The M7's Wi-Fi or Ethernet offload is on": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 的 Wi-Fi 或以太网卸载已开启"
          }
        }
      }
    },
    "The M7's Wi-Fi radio is on": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 的 Wi-Fi 射频已开启"
          }
        }
      }
    },
    "The M7's answer could not be read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不懂 M7 的应答"
          }
        }
      }
    },
    "The M7's answer did not match what this build reads; the daemon's log names the field.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 的应答和这个版本能读的格式不符；守护进程日志里写明了是哪个字段。"
          }
        }
      }
    },
    "The M7's firmware changed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 的固件变了"
          }
        }
      }
    },
    "The M7's own counters (wwan.dataTransferredRx/Tx).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 自己的计数器（wwan.dataTransferredRx/Tx）。"
          }
        }
      }
    },
    "The M7's signal is weak (RSRP %@ dBm)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M7 信号弱（RSRP %@ dBm）"
          }
        }
      }
    },
    "The Mac could not poll the M7": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没能读取 M7"
          }
        }
      }
    },
    "The Mac is attached to another network (findings: %llu)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 连着其他网络（发现 %llu 处）"
          }
        }
      }
    },
    "The Mac is attached to another network: %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 连着其他网络：%@。"
          }
        }
      }
    },
    "The Mac runs on battery and may sleep.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 正在用电池，可能会睡眠。"
          }
        }
      }
    },
    "The Mac's and the nodes' event journals are not read by this build yet; the open alerts are on the overview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本还不读取 Mac 和各节点的事件日志；未解决的告警显示在概览页。"
          }
        }
      }
    },
    "The REALITY target is degraded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "REALITY 目标降级"
          }
        }
      }
    },
    "The SIM is forecast to reach its %@ on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计 SIM 将于 %2$@ 达到“%1$@”"
          }
        }
      }
    },
    "The SIM meter and the M7's counter differ by %u ‰": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIM 流量表与 M7 计数器相差 %u ‰"
          }
        }
      }
    },
    "The SIM passed its warning in the cycle from %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 开始的周期内，SIM 已超过警告线"
          }
        }
      }
    },
    "The SIM plan is not recorded (`mooringctl sim set-plan`).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录 SIM 套餐（`mooringctl sim set-plan`）。"
          }
        }
      }
    },
    "The SIM's hard stop was reached in the cycle from %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 开始的周期内，SIM 已达到硬性上限"
          }
        }
      }
    },
    "The SIM's hard stop was reached in the cycle from %@; the exit stays down until the next cycle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 开始的周期内，SIM 已达到硬性上限；出口停止到下个周期。"
          }
        }
      }
    },
    "The Xray stats query failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xray 统计查询失败"
          }
        }
      }
    },
    "The agent on %@ is not enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的节点代理没有启用。"
          }
        }
      }
    },
    "The clock is not synchronised by NTP": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时钟没有经 NTP 同步"
          }
        }
      }
    },
    "The daemon could not read its record of the SIM's network and began it again, so on record is what the M7 reported at the first poll after that, which may not be what it reported when the carrier check and the billing cycle were recorded: a SIM changed before that is not noticed. The daemon reads the SIM's name and the network's codes only, so two SIMs of one carrier look alike.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程读不出原有的 SIM 卡网络记录，重新开始了一份，所以“登记时”是指此后第一次轮询时 M7 报告的内容，未必是登记运营商地址检查和计费周期那时报告的：在那之前换的卡不会被发现。守护进程只读 SIM 卡的名称和网络代码，所以同一运营商的两张卡看起来一样。"
          }
        }
      }
    },
    "The daemon had no record of the SIM's network when it began this one, so on record is what the M7 reported at the first poll after that, which may not be what it reported when the carrier check and the billing cycle were recorded: a SIM changed before that is not noticed. The daemon reads the SIM's name and the network's codes only, so two SIMs of one carrier look alike.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程开始这份记录时，之前没有留下 SIM 卡网络的记录，所以“登记时”是指此后第一次轮询时 M7 报告的内容，未必是登记运营商地址检查和计费周期那时报告的：在那之前换的卡不会被发现。守护进程只读 SIM 卡的名称和网络代码，所以同一运营商的两张卡看起来一样。"
          }
        }
      }
    },
    "The daemon has not reported a poll of the M7 yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程还没有报告读取 M7 的结果。"
          }
        }
      }
    },
    "The daemon reports after its first poll of the M7, which waits while macOS asks you to allow keychain or local network access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程要在第一次读取 M7 之后才开始报告；如果 macOS 正在请你允许钥匙串或本地网络访问，这次读取会一直等着。"
          }
        }
      }
    },
    "The daemon samples the egress once the exit runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口运行后，守护进程才会对出口采样。"
          }
        }
      }
    },
    "The daemon's document is version %u; this build reads version 1.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程的文档是第 %u 版；这个版本只能读取第 1 版。"
          }
        }
      }
    },
    "The device answering at the gateway is not the M7 that was pinned, so no password was sent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关上应答的设备不是固定过的那台 M7，所以没有发送密码。"
          }
        }
      }
    },
    "The device answering is not an MR7450 speaking the API this build reads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应答的设备不是这个版本能读取的 MR7450 接口。"
          }
        }
      }
    },
    "The egress %@ has no IPv4 address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口接口 %@ 没有 IPv4 地址。"
          }
        }
      }
    },
    "The egress does not resolve to an interface.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口无法对应到任何接口。"
          }
        }
      }
    },
    "The egress's IPv4 address is outside the M7's subnet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口接口的 IPv4 地址不在 M7 的子网内。"
          }
        }
      }
    },
    "The exit is degraded: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口降级：%@"
          }
        }
      }
    },
    "The exit's traffic left by the separate uplink, not by the M7: check the routes on both interfaces, then clear the latch with `mooringctl exit retry`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口流量走的是独立上行链路，没有走 M7：检查两个接口上的路由，然后用 `mooringctl exit retry` 解除锁存。"
          }
        }
      }
    },
    "The exit, its nodes, users and SIM meter appear once `mooringctl exit init` has created a deployment. Until then the daemon reads the M7 only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口、节点、用户和 SIM 流量表要等 `mooringctl exit init` 建好部署后才会出现。在那之前，守护进程只读取 M7。"
          }
        }
      }
    },
    "The gateway is not the pinned M7": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关不是固定过的那台 M7"
          }
        }
      }
    },
    "The history could not be read: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取历史记录：%@"
          }
        }
      }
    },
    "The history document is version %u; this build reads version 1.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录文档是第 %u 版；这个版本只能读取第 1 版。"
          }
        }
      }
    },
    "The history is longer than 4 MiB, so the app stopped reading it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录超过 4 MiB，应用已停止读取。"
          }
        }
      }
    },
    "The hourly target check's result could not be decoded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解码每小时目标检查的结果"
          }
        }
      }
    },
    "The keychain could not be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取钥匙串。"
          }
        }
      }
    },
    "The keychain or the kernel's tables failed on this Mac; the daemon's log (~/Library/Logs/Mooring/daemon.log) names the cause.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的钥匙串或内核表出了问题；原因见守护进程日志（~/Library/Logs/Mooring/daemon.log）。"
          }
        }
      }
    },
    "The line's carrier check is not recorded (`mooringctl exit record-carrier`).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录这条线路的运营商检查（`mooringctl exit record-carrier`）。"
          }
        }
      }
    },
    "The own-network declarations cannot be read; no declared network matches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取自有网络声明；没有声明的网络能匹配。"
          }
        }
      }
    },
    "The power helper exited.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电源助手已退出。"
          }
        }
      }
    },
    "The probe's traffic is not being counted on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探测在 %@ 上的流量没有被统计"
          }
        }
      }
    },
    "The router adapter is not set up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由器读取还没有配置"
          }
        }
      }
    },
    "The separate uplink is absent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立上行链路不存在。"
          }
        }
      }
    },
    "The separate uplink is the egress.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立上行链路就是出口接口。"
          }
        }
      }
    },
    "The uplink is saturated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上行已饱和"
          }
        }
      }
    },
    "Thermal state": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "散热状态"
          }
        }
      }
    },
    "This app carries no mooringctl": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用里没有 mooringctl"
          }
        }
      }
    },
    "This cycle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周期"
          }
        }
      }
    },
    "This cycle began on %@; the next begins on %@ (UTC). The meter counts this Mac's traffic through the M7, whichever SIM is in it. After a SIM change, or when the plan starts on another day, move the cycle with `mooringctl sim set-anchor`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周期从 %1$@ 开始，下个周期从 %2$@ 开始（UTC）。SIM 流量表计的是这台 Mac 经过 M7 的流量，不区分 M7 里是哪张 SIM 卡。换卡后，或者套餐改在另一天起算时，用 `mooringctl sim set-anchor` 调整周期。"
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月"
          }
        }
      }
    },
    "This screen fills in once a deployment exists on this Mac. `mooringctl exit init` creates it; until then the console shows the M7 router only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上有了部署后，这一页才会有内容。部署由 `mooringctl exit init` 创建；在那之前，控制台只显示 M7 路由器。"
          }
        }
      }
    },
    "Thresholds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阈值"
          }
        }
      }
